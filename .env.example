# ===========================================
# Printer Management System - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env && nano .env

# ===========================================
# MySQL Database
# ===========================================
MYSQL_ROOT_PASSWORD=your_secure_root_password_here
MYSQL_DATABASE=printer_management
MYSQL_USER=printer_admin
MYSQL_PASSWORD=your_secure_password_here

# ===========================================
# JWT Authentication (CHANGE THESE!)
# Generate with: openssl rand -hex 32
# ===========================================
JWT_SECRET=your_jwt_secret_min_32_chars_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_chars_here

# ===========================================
# URLs
# ===========================================
FRONTEND_URL=http://YOUR_SERVER_IP:8080
VITE_API_URL=/api

# ===========================================
# CUPS Socket (host CUPS via mounted socket)
# ===========================================
CUPS_SERVER=/var/run/cups/cups.sock

# ===========================================
# Network for printer discovery (optional)
# e.g., 192.168.170.0/24
# ===========================================
DEFAULT_NETWORK=

# ===========================================
# Driver Pack: lite (default) | common | full
# lite   = driverless IPP Everywhere (modern printers)
# common = adds Brother/Epson/Samsung drivers
# full   = large legacy driver packs (HP + Gutenprint)
# ===========================================
DRIVER_SET=lite

# ===========================================
# Timezone
# ===========================================
TZ=America/Chicago

# ===========================================
# SMTP Email (optional - for notifications)
# ===========================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ===========================================
# SSL (optional)
# ===========================================
SSL_DOMAIN=localhost
